---
// One property, as a card.
//
// An agency uploads its own photographs through the media library; until a
// property has one, the card still has to look deliberate rather than broken,
// so the space a photograph will occupy is filled rather than collapsed.
import type { Row } from "../lib/property-search";

interface Props {
	property: Row;
}

const { property: p } = Astro.props;

const money = new Intl.NumberFormat("en-GB", {
	style: "currency",
	currency: p.currency || "EUR",
	maximumFractionDigits: 0,
});

const pretty = (s: string) =>
	(s || "").replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());

const facts = [
	p.beds ? `${p.beds} bed` : null,
	p.baths ? `${p.baths} bath` : null,
	p.built_area ? `${p.built_area} m²` : null,
].filter(Boolean);
---

<li class="card">
	<div class="card__shot">
		{p.image
			? <img src={p.image.src} alt={p.image.alt} width="640" height="480" loading="lazy" decoding="async" />
			: <span>{pretty(p.property_type)}</span>}
	</div>
	<div class="card__body">
		<p class="card__price">
			{money.format(p.price ?? 0)}{p.dept === "rent" ? " pcm" : ""}
		</p>
		<h3 class="card__title"><a href={`/property/${p.slug}`}>{p.title}</a></h3>
		<p class="card__meta">{pretty(p.town)}{facts.length ? ` · ${facts.join(" · ")}` : ""}</p>
		<div class="badges">
			{p.new_build ? <span class="badge">New build</span> : null}
			{p.pool ? <span class="badge badge--quiet">Pool</span> : null}
			{p.availability && p.availability !== "available"
				? <span class="badge badge--quiet">{pretty(p.availability)}</span>
				: null}
		</div>
	</div>
</li>
