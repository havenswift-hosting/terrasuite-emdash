---
// The search form, used on the home page and above the results.
//
// A plain GET form. Every search is a URL a visitor can bookmark, send to
// somebody, or land on from a search engine, which is also the reason none of
// these filters can carry a nonce.
import { SORTS } from "../lib/property-search";

interface Props {
	towns: Array<{ value: string; count: number }>;
	types: Array<{ value: string; count: number }>;
	features?: Array<{ value: string; count: number }>;
	current?: Record<string, unknown>;
	variant?: "hero" | "inline";
}

const { towns, types, features = [], current = {}, variant = "hero" } = Astro.props;

const pretty = (s: string) =>
	(s || "").replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());

const chosen = (key: string, value: string) => {
	const v = current[key];
	return Array.isArray(v) ? v.includes(value) : v === value;
};
const value = (key: string) => (current[key] as string | number | undefined) ?? "";

// multiple={false} renders as multiple="false", which is still multiple.
// The attributes have to be absent, not falsey.
const listBox = variant === "inline" ? { multiple: true, size: 4 } : {};
---

<form class={`search ${variant === "inline" ? "search--inline" : ""}`} action="/search" method="get">
	<label class="field">
		<span>Looking to</span>
		<select name="dept">
			<option value="sale" selected={chosen("dept", "sale")}>Buy</option>
			<option value="rent" selected={chosen("dept", "rent")}>Rent</option>
		</select>
	</label>

	<label class={`field ${variant === "inline" ? "field--wide" : ""}`}>
		<span>Where</span>
		<select name="town" {...listBox}>
			{variant === "hero" && <option value="">Anywhere</option>}
			{towns.map((t) => (
				<option value={t.value} selected={chosen("towns", t.value)}>
					{pretty(t.value)} ({t.count})
				</option>
			))}
		</select>
	</label>

	<label class={`field ${variant === "inline" ? "field--wide" : ""}`}>
		<span>Type</span>
		<select name="type" {...listBox}>
			{variant === "hero" && <option value="">Any type</option>}
			{types.map((t) => (
				<option value={t.value} selected={chosen("types", t.value)}>
					{pretty(t.value)} ({t.count})
				</option>
			))}
		</select>
	</label>

	<label class="field">
		<span>Price from</span>
		<input type="number" name="min_price" step="10000" min="0" value={value("minPrice")} inputmode="numeric" />
	</label>

	<label class="field">
		<span>Price to</span>
		<input type="number" name="max_price" step="10000" min="0" value={value("maxPrice")} inputmode="numeric" />
	</label>

	<label class="field">
		<span>Beds, at least</span>
		<input type="number" name="beds" min="0" max="12" value={value("minBeds")} inputmode="numeric" />
	</label>

	{variant === "inline" && (
		<>
			<label class="field">
				<span>Baths, at least</span>
				<input type="number" name="baths" min="0" max="12" value={value("minBaths")} inputmode="numeric" />
			</label>

			<label class="field">
				<span>Built, at least m&sup2;</span>
				<input type="number" name="built" step="10" min="0" value={value("minBuilt")} inputmode="numeric" />
			</label>

			<label class="field">
				<span>Must have</span>
				<select name="feature">
					<option value="">Anything</option>
					{features.map((f) => (
						<option value={f.value} selected={chosen("feature", f.value)}>
							{pretty(f.value)} ({f.count})
						</option>
					))}
				</select>
			</label>

			<label class="field">
				<span>Order by</span>
				<select name="sort">
					{SORTS.map(([key, label]) => (
						<option value={key} selected={chosen("orderBy", key)}>{label}</option>
					))}
				</select>
			</label>

			<label class="check"><input type="checkbox" name="pool" value="1" checked={Boolean(current.pool)} /> Pool</label>
			<label class="check"><input type="checkbox" name="new_build" value="1" checked={Boolean(current.newBuild)} /> New build</label>
		</>
	)}

	<button class="btn" type="submit">Search</button>
</form>
