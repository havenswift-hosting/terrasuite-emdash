---
// The layout every page uses.
//
// It hands EmDash a page context so the host contributes its own head tags, SEO
// and JSON-LD, and so a plugin can add validated metadata. Everything else is
// ours: one stylesheet, no webfont, nothing fetched from another host.
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import "../styles/site.css";

interface Props {
	title: string;
	description?: string | null;
	canonical?: string | null;
	/** Set on a property page so plugin contributions know what is being shown. */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, description, canonical, content } = Astro.props;

const [settings, menu] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(settings.cacheHint);
	Astro.cache.set(menu.cacheHint);
}

const siteTitle = (settings.data?.title as string) || "TerraSuite";
const tagline = (settings.data?.tagline as string) || "";
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;

const page = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: title,
	description: description ?? tagline,
	canonical,
	content,
	siteName: siteTitle,
});

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<EmDashHead page={page} />
	</head>
	<body>
		<EmDashBodyStart page={page} />

		<a class="skip" href="#main">Skip to the results</a>

		<header class="masthead">
			<div class="wrap masthead__inner">
				<a class="brand" href="/">{siteTitle.split(" ")[0]}<span>.</span></a>
				<nav aria-label="Main">
					{menu.data?.items?.length
						? menu.data.items.map((item) => (
								<a href={item.url} target={item.target}>{item.label}</a>
							))
						: (
							<>
								<a href="/search">Property search</a>
								<a href="/search?dept=rent">To let</a>
								<a href="/about">About us</a>
							</>
						)}
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="footer">
			<div class="wrap">
				<div class="footer__inner">
					<div>
						<h3>Buying</h3>
						<ul>
							<li><a href="/search?dept=sale">Property for sale</a></li>
							<li><a href="/search?dept=sale&amp;pool=1">With a pool</a></li>
							<li><a href="/search?sort=newest">Just listed</a></li>
						</ul>
					</div>
					<div>
						<h3>Renting</h3>
						<ul>
							<li><a href="/search?dept=rent">Property to let</a></li>
						</ul>
					</div>
					<div>
						<h3>The agency</h3>
						<ul>
							<li><a href="/about">About us</a></li>
							<li><a href="/_emdash/admin">Staff sign in</a></li>
						</ul>
					</div>
				</div>
				<p class="footer__note">
					&copy; {year} {siteTitle}. Built with TerraSuite for EmDash.
				</p>
			</div>
		</footer>

		<EmDashBodyEnd page={page} />
	</body>
</html>
