---
// The home page: one decision, with the search as the dominant element.
//
// The same argument the TerraSuite theme makes on WordPress. A visitor arrived
// to look for somewhere to live, so the first thing on the page is the thing
// that does that, and everything else is below it.
import Site from "../layouts/Site.astro";
import SearchForm from "../components/SearchForm.astro";
import PropertyCard from "../components/PropertyCard.astro";
import { search, facets, stats } from "../lib/property-search";

const { towns, types } = facets();
const { total, towns: townCount } = stats();

const featured = search({
	dept: "sale",
	availability: "available",
	orderBy: "newest",
	perPage: 6,
});
const byTown = towns.slice().sort((a, b) => b.count - a.count).slice(0, 12);

const pretty = (s: string) =>
	(s || "").replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
---

<Site
	title="Property for sale and to let"
	description="Search every property on our books by price, size, location and the things that actually matter."
>
	<section class="hero">
		<div class="wrap">
			<h1>Find the one you are looking for.</h1>
			<p>
				{total.toLocaleString("en-GB")} properties across {townCount} towns, searchable by
				everything that matters and nothing that does not.
			</p>
			<div style="margin-top:2rem">
				<SearchForm towns={towns} types={types} />
			</div>
		</div>
	</section>

	<section class="band">
		<div class="wrap">
			<div class="results-head">
				<h2>Just listed</h2>
				<p><a href="/search?sort=newest">See everything just listed</a></p>
			</div>
			<ul class="grid">
				{featured.rows.map((p) => <PropertyCard property={p} />)}
			</ul>
		</div>
	</section>

	<section class="band band--sand">
		<div class="wrap">
			<h2>Where we sell</h2>
			<p class="lead">
				Every town we hold property in, with what is on our books there today.
			</p>
			<ul class="towns">
				{byTown.map((t) => (
					<li><a href={`/area/${t.value}`}>{pretty(t.value)} <span aria-hidden="true">&middot;</span> {t.count}</a></li>
				))}
			</ul>
		</div>
	</section>

	<section class="band">
		<div class="wrap wrap--narrow prose">
			<h2>How our search works</h2>
			<p>
				Price, size, bedrooms, bathrooms, type, town and the features you actually care
				about, all at once, on every property we hold. No waiting, no page of results that
				ignores half of what you asked for.
			</p>
			<p>
				<a class="btn" href="/search">Search every property</a>
			</p>
		</div>
	</section>
</Site>
