---
// The home page: one decision, with the search as the dominant element.
//
// The same argument the TerraSuite theme makes on WordPress. A visitor arrived
// to look for somewhere to live, so the first thing on the page is the thing
// that does that, and everything else is below it.
import Site from "../layouts/Site.astro";
import SearchForm from "../components/SearchForm.astro";
import PropertyCard from "../components/PropertyCard.astro";
import { search, facets, stats } from "../lib/property-search";

const { towns, types } = facets();
const { total, towns: townCount } = stats();

// Seven, not six: the newest one goes in the hero and the other six fill the
// grid below it, so the same property is never shown twice on the page.
const featured = search({
	dept: "sale",
	availability: "available",
	orderBy: "newest",
	perPage: 7,
});

const lead = featured.rows[0] ?? null;
const rest = featured.rows.slice(1);

const money = (p: { price: number | null; currency: string | null }) =>
	new Intl.NumberFormat("en-GB", {
		style: "currency",
		currency: p.currency || "EUR",
		maximumFractionDigits: 0,
	}).format(p.price ?? 0);
const byTown = towns.slice().sort((a, b) => b.count - a.count).slice(0, 12);

const pretty = (s: string) =>
	(s || "").replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
---

<Site
	title="Property for sale and to let"
	description="Search every property on our books by price, size, location and the things that actually matter."
>
	<section class="hero">
		<div class="wrap hero__inner">
			<div class="hero__copy">
				<h1>Find the one you are looking for.</h1>
				<p>
					{total.toLocaleString("en-GB")} properties across {townCount} towns, searchable by
					everything that matters and nothing that does not.
				</p>
			</div>

			{/* The newest thing on the books, beside the heading rather than a
			    column of empty space. On a phone it moves below the search,
			    because the search is what somebody came here to use. */}
			{lead && (
				<a class="hero__feature" href={`/property/${lead.slug}`}>
					<span class="hero__feature-shot">
						{lead.image
							? <img src={lead.image.src} alt={lead.image.alt} width="640" height="480" decoding="async" />
							: <span>{pretty(lead.property_type)}</span>}
						<span class="hero__feature-flag">Just listed</span>
					</span>
					<span class="hero__feature-meta">
						<strong>{money(lead)}</strong>
						<span>{lead.title}</span>
					</span>
				</a>
			)}

			<div class="hero__search">
				<SearchForm towns={towns} types={types} />
			</div>
		</div>
	</section>

	<section class="band">
		<div class="wrap">
			<div class="results-head">
				<h2>Just listed</h2>
				<p><a href="/search?sort=newest">See everything just listed</a></p>
			</div>
			<ul class="grid">
				{rest.map((p) => <PropertyCard property={p} />)}
			</ul>
		</div>
	</section>

	<section class="band band--sand">
		<div class="wrap">
			<h2>Where we sell</h2>
			<p class="lead">
				Every town we hold property in, with what is on our books there today.
			</p>
			<ul class="towns">
				{byTown.map((t) => (
					<li><a href={`/area/${t.value}`}>{pretty(t.value)} <span aria-hidden="true">&middot;</span> {t.count}</a></li>
				))}
			</ul>
		</div>
	</section>

	<section class="band">
		<div class="wrap wrap--narrow prose">
			<h2>How our search works</h2>
			<p>
				Price, size, bedrooms, bathrooms, type, town and the features you actually care
				about, all at once, on every property we hold. No waiting, no page of results that
				ignores half of what you asked for.
			</p>
			<p>
				<a class="btn" href="/search">Search every property</a>
			</p>
		</div>
	</section>
</Site>
