---
// A page an agency will rewrite on its first afternoon.
//
// It is here because the footer links to it and a template that ships a broken
// link is a template that teaches a bad habit. The words are deliberately about
// the agency rather than about us.
import Site from "../layouts/Site.astro";
import { stats, facets } from "../lib/property-search";

const { total, towns: townCount } = stats();
const { towns } = facets();

const pretty = (s: string) =>
	(s || "").replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
---

<Site
	title="About us"
	description="Who we are, where we sell, and how to reach somebody who can help."
>
	<section class="band">
		<div class="wrap wrap--narrow prose">
			<h1>About us</h1>
			<p class="lead">
				We sell and let property in {townCount} towns, and we have
				{" "}{total.toLocaleString("en-GB")} on our books this morning.
			</p>

			<h2>What we do</h2>
			<p>
				Replace this with your own words. Who the agency is, how long it has been
				here, what it is known for, and the names of the people a client will
				actually speak to. It is the page people read before they ring, so it is
				worth writing properly rather than leaving as it came.
			</p>

			<h2>Where we sell</h2>
			<ul class="towns">
				{towns.map((t) => (
					<li><a href={`/area/${t.value}`}>{pretty(t.value)}</a></li>
				))}
			</ul>

			<h2>Talk to us</h2>
			<p>
				Put your telephone number, your email address and your office hours here,
				and say which of them is quickest. An address that a visitor has to hunt
				for costs enquiries.
			</p>

			<p><a class="btn" href="/search">Search every property</a></p>
		</div>
	</section>
</Site>
